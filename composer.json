{
  "name": "solophp/repository",
  "type": "library",
  "description": "Typed PHP repositories with consistent translation fallback and batch-loaded relations",
  "keywords": [
    "repository",
    "crud",
    "translations",
    "relations",
    "php"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Solo\\Repository\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\Repository\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "doctrine/dbal": "^4.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "scripts": {
    "cs-check": "phpcs --standard=PSR12 src/",
    "cs-fix": "phpcbf --standard=PSR12 src/",
    "analyze": "phpstan analyze",
    "test:database": "phpunit -c phpunit.database.xml --do-not-cache-result",
    "test": [
      "@cs-check",
      "@analyze",
      "phpunit"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "1.1.x-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "homepage": "https://github.com/SoloPHP/Repository",
  "support": {
    "issues": "https://github.com/SoloPHP/Repository/issues",
    "source": "https://github.com/SoloPHP/Repository"
  }
}
